# Copy this file to .env for local development. Never commit .env.
# In production these are set in the Vercel dashboard:
#   Project → Settings → Environment Variables

# ---- The database (required) ----
# Supabase dashboard → Connect → Connection string → Transaction pooler.
# Use the POOLER string (port 6543), not the direct connection: serverless
# functions open and drop connections constantly and the pooler is what
# stops that exhausting the database.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Basic auth for /admin/ and PATCH /api/bookings/:ref (required) ----
# Without these the diary refuses everyone, which is the safe default.
ADMIN_USER=
ADMIN_PASSWORD=

# ---- Email (optional) ----
# Resend API key for the two confirmation emails. Leave it unset and
# bookings still save — the emails are simply skipped and the server logs
# that it skipped them. A mail provider having a bad morning must never
# lose someone's booking.
RESEND_API_KEY=

# Where the shop's copy of each booking goes.
SHOP_EMAIL=quintoncarpets@gmail.com

# Verified sender on the shop's own domain.
MAIL_FROM=Quinton Carpets <bookings@quintoncarpets.co.uk>
