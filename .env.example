# Local development only. Production secrets live in Cloudflare:
#   npx wrangler pages secret put <NAME>

# Resend API key for the two confirmation emails. Leave it unset and
# bookings still save to D1 — the emails are simply skipped.
RESEND_API_KEY=

# Where the shop's copy of each booking goes.
SHOP_EMAIL=quintoncarpets@gmail.com

# Verified sender on the shop's own domain.
MAIL_FROM=Quinton Carpets <bookings@quintoncarpets.co.uk>

# Basic auth for /admin/ and for PATCH /api/bookings/:ref
ADMIN_USER=
ADMIN_PASSWORD=
