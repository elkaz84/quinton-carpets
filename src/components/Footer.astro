---
import { BUSINESS } from "../data/business.ts";
const year = new Date().getFullYear();
---

<footer class="site">
  <div class="wrap">
    <div class="cols4">
      <div>
        <div class="brand" style="margin-bottom:14px">
          <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
            <rect x="1" y="1" width="38" height="38" rx="7" fill="#FFC61A"></rect>
            <text x="5" y="27" fill="#15120C" font-family="Archivo, sans-serif" font-size="17" font-weight="800" letter-spacing="-1.5">QC</text>
            <path d="M29 5a6 6 0 1 1-5.2 9M29 8.5a2.5 2.5 0 1 1-2.2 3.8" fill="none" stroke="#15120C" stroke-width="2" stroke-linecap="round"></path>
            <path d="M23 32h10" stroke="#15120C" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <span class="wordmark" style="color:var(--slab-head)">QUINTON CARPETS<span style="color:var(--slab-muted)">BIRMINGHAM · EST. B32</span></span>
        </div>
        <p style="font-size:.9rem; color:var(--slab-muted); max-width:34ch">
          When it comes to carpets, we are on a roll. Carpet, underlay, laminate and vinyl,
          supplied and fitted across Birmingham and the Black Country.
        </p>
      </div>

      <div>
        <h4>Shop</h4>
        <ul>
          <li><a href="/ranges/?material=Carpet">Carpets</a></li>
          <li><a href="/ranges/?material=Underlay">Underlay</a></li>
          <li><a href="/ranges/?material=Laminate">Laminate</a></li>
          <li><a href="/ranges/?material=Vinyl">Vinyl</a></li>
        </ul>
      </div>

      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="/estimate/">Instant estimate</a></li>
          <li><a href="/book/">Free measure &amp; consultation</a></li>
          <li><a href="/book/">Carpet fitting</a></li>
          <li><a href="/referrals/">Refer a friend</a></li>
        </ul>
      </div>

      <div>
        <h4>Visit</h4>
        <ul>
          <li>589–613 Hagley Road West,<br />Birmingham, B32 1BY</li>
          <li><a href={BUSINESS.phoneHref}>{BUSINESS.phone}</a></li>
          <li><a href={BUSINESS.mobileHref}>{BUSINESS.mobile}</a></li>
          <li><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></li>
          <li style="color:var(--slab-muted)">Mon–Sat 10–6 · Sun 10–4</li>
        </ul>
      </div>
    </div>

    <div class="fine">
      <span>© {year} Quinton Carpets, Birmingham. <a href="/privacy/">Privacy notice</a></span>
      <span>
        Prices shown are guide prices and are confirmed on the free measure.
        Payment is taken in the shop.
      </span>
    </div>
  </div>
</footer>
