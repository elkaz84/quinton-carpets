---
import { BUSINESS, NAV } from "../data/business.ts";

// Trailing-slash-tolerant active check, so /ranges/?material=carpet
// still lights up "Ranges".
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, "") || "/";
  return h === "/" ? path === "/" : path === h || path.startsWith(h + "/");
};
---

<header class="site">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${BUSINESS.name} — home`}>
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <rect x="1" y="1" width="38" height="38" rx="7" fill="#15120C"></rect>
        <g stroke="#FFC61A" stroke-width="2.6" stroke-linecap="round">
          <path d="M9 12h22M9 20h22M9 28h22"></path>
        </g>
        <g stroke="#FFF" stroke-width="1.5" opacity=".55">
          <path d="M13 8v24M20 8v24M27 8v24"></path>
        </g>
        <circle cx="30" cy="28.5" r="6.5" fill="#FFC61A" stroke="#15120C" stroke-width="2"></circle>
      </svg>
      <span class="wordmark">QUINTON CARPETS<span>BIRMINGHAM · EST. B32</span></span>
    </a>

    <button id="menutoggle" type="button" aria-expanded="false" aria-controls="mainnav" aria-label="Menu">
      <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M1 1h18M1 7h18M1 13h18"></path>
      </svg>
    </button>

    <nav class="main" id="mainnav" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class={isActive(item.href) ? "active" : undefined}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="callbtn" href={BUSINESS.phoneHref}>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14.5 11.3v2a1.3 1.3 0 0 1-1.5 1.3A13 13 0 0 1 1.4 3 1.3 1.3 0 0 1 2.7 1.5h2A1.3 1.3 0 0 1 6 2.6c.1.7.3 1.3.5 2a1.3 1.3 0 0 1-.3 1.4l-.8.8a10.4 10.4 0 0 0 4 4l.8-.8a1.3 1.3 0 0 1 1.4-.3c.6.2 1.3.4 2 .5a1.3 1.3 0 0 1 1.1 1.3Z"></path>
      </svg>
      <span class="lbl">{BUSINESS.phone}</span>
      <span class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">
        Call the shop on {BUSINESS.phone}
      </span>
    </a>
  </div>
</header>
