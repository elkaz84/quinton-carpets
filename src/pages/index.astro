---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import { allRanges, showcaseRanges } from "../lib/ranges.ts";
import { QUOTES } from "../data/quotes.ts";
import { BUSINESS } from "../data/business.ts";
import catCarpets from "../assets/site/cat-carpets.jpg";
import catLaminate from "../assets/site/cat-laminate.jpg";
import catVinyl from "../assets/site/cat-vinyl.jpg";
import hagleyTwist from "../assets/ranges/hagley-twist.jpg";
import bartleyBerber from "../assets/ranges/bartley-berber.jpg";
import californianHerringbone from "../assets/ranges/californian-herringbone.jpg";
import woodgateLoop from "../assets/ranges/woodgate-loop.jpg";

const showcase = showcaseRanges(await allRanges());

const WORK = [
  { title: "Laminate flooring project", image: catLaminate, alt: "Laminate flooring project by Quinton Carpets" },
  { title: "Living room carpet", image: catCarpets, alt: "Living room carpet project by Quinton Carpets" },
  { title: "Vinyl flooring project", image: catVinyl, alt: "Vinyl flooring project by Quinton Carpets" },
  { title: "Stair carpet fitting", image: hagleyTwist, alt: "Stair carpet fitting by Quinton Carpets" },
  { title: "Berber carpet project", image: bartleyBerber, alt: "Berber carpet project by Quinton Carpets" },
  { title: "Herringbone flooring project", image: californianHerringbone, alt: "Herringbone flooring project by Quinton Carpets" },
  { title: "Loop carpet project", image: woodgateLoop, alt: "Loop carpet project by Quinton Carpets" },
];

const STEPS = [
  { n: "STEP 01", h: "Price it online", p: "Pick a range, put your room sizes in and add underlay and fitting. You get an itemised estimate and a reference code in about two minutes." },
  { n: "STEP 02", h: "Book a free measure", p: "Choose a day and a time window. Booking costs nothing and commits you to nothing — we ring you back within one working day." },
  { n: "STEP 03", h: "Choose in the shop", p: "We measure up, then you see and feel the real thing on Hagley Road West and confirm the final price. Payment is taken in the shop, never online." },
  { n: "STEP 04", h: "Our team fits it", p: "Old flooring lifted and taken away, gripper and door bars fitted, everything hoovered before we leave. Then your referral code goes live." },
];
---

<Base
  title="Quinton Carpets — carpets, laminate and vinyl in Quinton, Birmingham"
  description="Birmingham's favourite carpet shop, on Hagley Road West in Quinton. Hundreds of samples, our own fitters, a free measure and an instant online estimate."
>
  <Hero showcase={showcase} />
  <Ticker />

  <!-- about the shop -->
  <div class="section plain about-section">
    <div class="wrap">
      <div class="about-grid rv">
        <div class="about-photo">
          <img src="/about-aman.jpg" alt="Aman, owner of Quinton Carpets" />
        </div>
        <div class="about-copy">
          <p class="eyebrow">About Us</p>
          <h2>Hi, I am Aman and I am the owner of Quinton Carpets.</h2>
          <p class="lede">
            Hi, I am Aman and I am the owner of Quinton Carpets, a Birmingham carpet shop which
            I run together with my brother. We are a local carpet and flooring business
            established in 2002 with the motto: family run, family prices and family service.
          </p>
          <p>
            I, myself, have two beautiful sons and really do appreciate what type of carpet or
            flooring different families need. I also fully understand budget amounts and that
            customers, like yourselves, get the best value for money.
          </p>
          <p>
            We really do pride ourselves in these morals. I want my business to be successful
            long-term for my children and this means that the basics for my customers have to be
            done right. And this is really what I guarantee. <strong>We will do it right.</strong>
          </p>
          <p>
            I, personally, can come and measure for you, fit for you or give you honest advice
            (if wanted or needed). We charge honest amounts and make sure you are happy with what
            you have bought and paid for. We want to carry on trading and we make sure we look
            after our customers to do this.
          </p>
          <p>
            Have a look at our reviews to hear what some of our customers – just like you – have
            said.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- partners -->
  <div class="partner-bar" aria-label="Flooring brands and trade partners">
    <div class="partner-logos">
      <span class="partner-logo lifestyle">lifestyle<small>FLOORS</small></span>
      <span class="partner-logo cloud">CLOUD<br /><b>9</b></span>
      <span class="partner-logo cfs">◆<small>CFS</small></span>
      <span class="partner-logo cormar">CORMAR<small>CARPET CO</small></span>
    </div>
  </div>

  <!-- work gallery -->
  <div class="section plain work-section">
    <div class="wrap">
      <p class="eyebrow rv">Our work</p>
      <h2 class="rv" style="margin-bottom:12px">Some of our work.</h2>
      <p class="lede rv" style="margin-bottom:30px">
        From a single bedroom to a full house, our own fitters take care of the details from
        preparation through to the final clean-up.
      </p>
      <div class="work-grid rv">
        {WORK.map((item) => (
            <figure class="work-card">
              <img src={item.image.src} alt={item.alt} loading="lazy" />
              <figcaption>{item.title}</figcaption>
            </figure>
        ))}
      </div>
    </div>
  </div>

  <!-- how it works -->
  <div class="section">
    <div class="wrap">
      <p class="eyebrow">From first look to fitted</p>
      <h2 style="margin-bottom:12px">Four steps, in this order.</h2>
      <p class="lede" style="margin-bottom:34px">
        Every step before the fitting is free. You only pay once you've chosen, in the shop.
      </p>
    </div>
    <div class="wrap">
      <div class="steps">
        {
          STEPS.map((s) => (
            <div class="step">
              <span class="n">{s.n}</span>
              <h4>{s.h}</h4>
              <p>{s.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- testimonials -->
  <div class="section">
    <div class="wrap">
      <p class="eyebrow rv">What Birmingham says</p>
      <h2 class="rv" style="margin-bottom:10px">Reviews from Google, Yell, Facebook and Yelp.</h2>
      <p class="lede rv" style="margin-bottom:32px">
        Every word below was written by a real customer on a public review site. Nothing has
        been edited.
      </p>
      <div class="cols rv">
        {
          QUOTES.map((q) => (
            <figure class="quote">
              <div class="stars" role="img" aria-label="5 out of 5">
                {
                  Array.from({ length: 5 }).map(() => (
                    <svg viewBox="0 0 16 16" fill="#FFC61A" stroke="#15120C" stroke-width=".8" aria-hidden="true">
                      <path d="m8 1 2 4.4 4.8.5-3.6 3.2 1 4.7L8 11.4 3.8 13.8l1-4.7L1.2 5.9 6 5.4Z" />
                    </svg>
                  ))
                }
              </div>
              <p style="margin-top:10px">“{q.t}”</p>
              <figcaption class="who"><b>{q.n}</b> · {q.s}</figcaption>
            </figure>
          ))
        }
      </div>
      <div class="review-strip rv">
        <div class="review-score" aria-label="Five star Google reviews">
          <span class="review-stars" aria-hidden="true">★★★★★</span>
          <strong>Real reviews from real customers</strong>
          <small>Read the latest reviews on Google</small>
        </div>
        <div class="review-actions">
          <a class="btn ghost sm" href={BUSINESS.mapsUrl} target="_blank" rel="noopener noreferrer">Read our Google reviews</a>
          <a class="btn yellow sm" href={BUSINESS.mapsUrl} target="_blank" rel="noopener noreferrer">Leave a review</a>
        </div>
      </div>
    </div>
  </div>

</Base>
